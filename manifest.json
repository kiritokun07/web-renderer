{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.0",
  "default_locale": "zh_CN",
  "action": {
    "default_title": "Web Renderer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline'; child-src 'self' blob:; object-src 'none'; base-uri 'none';"
  }
}
